# Site configuration
NEXT_PUBLIC_SITE_URL=https://elironico.com

# Google Search Console API key (optional)
# Nota: Search Console endpoint /api/google-search-console/submit-sitemap requiere credenciales OAuth2 / cuenta de servicio.
GOOGLE_SEARCH_CONSOLE_API_KEY=AIzaSy...your_search_console_api_key...
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://elironico.com
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}'
# Or use base64 encoded account JSON:
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_BASE64=ewoJInR5cGUiOiAic2VydmljZV9hY2NvdW50IiwKCSJwcm9qZWN0X2lkIjogIi4uLiIsCgkicHJpdmF0ZV9rZXlfaWQiOiAiLi4uIiwKCSJwcml2YXRlX2tleSI6ICJ..."

# Google Indexing API service account credentials
# Either paste the full JSON string or use base64-encoded JSON.
GOOGLE_INDEXING_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}'
# Or use:
GOOGLE_INDEXING_SERVICE_ACCOUNT_BASE64=ewoJInR5cGUiOiAic2VydmljZV9hY2NvdW50IiwKCSJwcm9qZWN0X2lkIjogIi4uLiIsCgkicHJpdmF0ZV9rZXlfaWQiOiAiLi4uIiwKCSJwcml2YXRlX2tleSI6ICJ..."
