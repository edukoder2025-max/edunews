# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site URL Config
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Google Gemini API Keys
GEMINI_API_KEY=your-primary-gemini-api-key
GEMINI_API_KEY_FALLBACK=your-fallback-gemini-api-key-optional

# Google Custom Search Engine (for Dual-Source Pipeline)
GOOGLE_CSE_KEY=your-google-cloud-custom-search-api-key
GOOGLE_CSE_ID=your-google-custom-search-engine-id

# Monetization (Optional)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your-adsense-id
